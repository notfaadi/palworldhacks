---
import SeoGuideLayout from '../../layouts/SeoGuideLayout.astro';
import { SEO_INTROS } from '../../data/seo-intros';
import SeoDataTable from '../../components/SeoDataTable.astro';
import { modMenuFeatures } from '../../data/palworld-mod-menu-features';
---

<SeoGuideLayout pathname="/palworld-mod-menu/" breadcrumbLabel="Mod menu" intro={SEO_INTROS['/palworld-mod-menu/']!}>
  <h2>Palworld mod menu features on patch 1.0.5</h2>
  <p>
    A Palworld mod menu bundles ESP, teleport, speed hacks and item spawning behind one overlay for Steam and Xbox
    Game Pass PC. We document external menus with <strong>no DLL injection</strong> into Pocketpair’s executable — that
    is the stated trust basis for “undetected” relative to internal hooks, not a ban-proof guarantee on live co-op.
  </p>
  <SeoDataTable
    caption="Mod menu modules — test on private servers before official realms"
    columns={[
      { key: 'feature', label: 'Feature' },
      { key: 'description', label: 'What it does' },
      { key: 'risk', label: 'Risk notes' },
    ]}
    rows={modMenuFeatures}
  />
  <h2>Palworld ESP and teleport setup</h2>
  <p>
    Run borderless windowed on Windows 11, disable conflicting overlays, then enable Pal ESP before player ESP so you
    can see boss phases. Teleport to tower landings only after saving — co-op guests may rubber-band if the host
    teleports mid-fight.
  </p>
  <p>
    Download the readme pack on <a href="/download/">download</a>, follow <a href="/how-to-install/">install steps</a>,
    and read <a href="/faq/">FAQ</a> before enabling speed hacks on Game Pass PC.
  </p>
</SeoGuideLayout>
