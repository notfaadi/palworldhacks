---
import SeoGuideLayout from '../../layouts/SeoGuideLayout.astro';
import { SEO_INTROS } from '../../data/seo-intros';
import SeoDataTable from '../../components/SeoDataTable.astro';
import { allPalworldItemIds } from '../../data/palworld-item-ids';
import { itemListSchema } from '../../utils/schema';
---

<SeoGuideLayout
  pathname="/palworld-item-spawner/"
  breadcrumbLabel="Item spawner"
  intro={SEO_INTROS['/palworld-item-spawner/']!}
  jsonLd={itemListSchema(
    allPalworldItemIds.map((row) => ({
      name: row.name,
      url: '/palworld-item-spawner/',
    })),
  )}
>
  <h2>Palworld item IDs for spawners and GiveItem</h2>
  <p>
    Trainers, mod menus and admin consoles all reference the same Palworld item IDs. Use this list with{' '}
    <code>GiveItem {`{ItemID}`} {`{Count}`}</code> on a dedicated server or with your Palworld item spawner module
    offline. IDs can shift after Pocketpair balance patches — verify on 1.0.5 before sharing a table publicly.
  </p>
  <SeoDataTable
    caption="Common Palworld spawn IDs — expand with game data exports for full coverage"
    columns={[
      { key: 'name', label: 'Item / Pal' },
      { key: 'itemId', label: 'Item ID' },
      { key: 'category', label: 'Category' },
    ]}
    rows={allPalworldItemIds}
  />
  <h2>Palworld spawn item command examples</h2>
  <pre class="not-prose overflow-x-auto rounded-lg border border-border bg-muted/20 p-4 text-sm"><code>{`GiveItem PalSphere_Mega 50
GiveItem AssaultRifle_Default1 1
GiveItem Cake 10
GivePal JetDragon 1`}</code></pre>
  <p>
    Pair spawning with our <a href="/palworld-console-commands/">console commands</a> guide and{' '}
    <a href="/how-to-install/">install checklist</a> so Steam cloud saves stay intact.
  </p>
</SeoGuideLayout>
