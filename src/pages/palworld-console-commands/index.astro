---
import SeoGuideLayout from '../../layouts/SeoGuideLayout.astro';
import { SEO_INTROS } from '../../data/seo-intros';
import SeoDataTable from '../../components/SeoDataTable.astro';
import { palworldCheatCodeTips, palworldConsoleCommands } from '../../data/palworld-console-commands';
import { itemListSchema } from '../../utils/schema';
---

<SeoGuideLayout
  pathname="/palworld-console-commands/"
  breadcrumbLabel="Console commands"
  intro={SEO_INTROS['/palworld-console-commands/']!}
  jsonLd={itemListSchema(
    palworldConsoleCommands.map((row) => ({
      name: row.command,
      url: '/palworld-console-commands/',
    })),
  )}
>
  <h2>Palworld console commands — admin cheat codes</h2>
  <p>
    Pocketpair exposes these Palworld console commands on dedicated servers and some offline admin sessions. They are
    the cleanest “cheat codes” when you host co-op for friends on Windows 10 or 11 — no trainer required if you trust
    the server password.
  </p>
  <SeoDataTable
    caption="Copy commands into the dedicated server console — Palworld 1.0.5"
    columns={[
      { key: 'command', label: 'Command' },
      { key: 'example', label: 'Example' },
      { key: 'notes', label: 'Notes' },
    ]}
    rows={palworldConsoleCommands}
  />
  <h2>Palworld cheat codes — safety on Steam and Game Pass</h2>
  <ul>
    {palworldCheatCodeTips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>
  <p>
    Need item names for <code>GiveItem</code>? Use our{' '}
    <a href="/palworld-item-spawner/">Palworld item spawner and item IDs</a> table, then{' '}
    <a href="/download/">download</a> the trainer pack if you prefer hotkeys over typing admin lines.
  </p>
</SeoGuideLayout>
