---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, getBlogTags, getFeaturedBlogPost } from '../../data/blog';
import { t } from '../../i18n';
import { resolvePageSeo, canonicalUrl } from '../../config/seo';
import { getSeoPageEntry } from '../../data/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { blogPagePath, getBlogPageCount, getBlogPostsForPage } from '../../utils/blog-pagination';
import SeoInternalCta from '../../components/SeoInternalCta.astro';
import { CARD_IMAGE_WIDTHS, webpSrc } from '../../utils/responsiveImage';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/blog/');
const entry = getSeoPageEntry('/blog/')!;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const pageOne = getBlogPostsForPage(1);
const totalBlogPages = getBlogPageCount();
const nextPageHref = totalBlogPages > 1 ? blogPagePath(2) : undefined;

const featured = getFeaturedBlogPost();
const showFeatured = featured && pageOne.posts.some((p) => p.slug === featured.slug);
const gridForPage = pageOne.posts.filter((p) => p.slug !== featured?.slug);
const tags = getBlogTags();
const lcpImage = webpSrc(featured?.image ?? blogPosts[0]!.image, CARD_IMAGE_WIDTHS[0]);

const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  ogImageAlt={entry.h1}
  jsonLd={[
    collectionPageSchema({
      name: entry.h1,
      description: entry.description,
      url: '/blog/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  {nextPageHref && <link slot="head" rel="next" href={canonicalUrl(nextPageHref)} />}
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" fetchpriority="high" />

  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <section
    class="border-y border-border bg-muted/20 py-12 md:py-16"
    aria-labelledby="blog-latest-title"
    data-blog-index
    data-empty-message={t.blog.emptyFilter}
  >
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h1 id="blog-latest-title" class="section-header__title">{entry.h1}</h1>
        <p class="section-header__subtitle">{entry.description}</p>
      </header>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter articles by topic"
          data-blog-filters
        >
          <button
            type="button"
            class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
            data-blog-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAll}
          </button>
          {
            tags.map((tag) => (
              <button
                type="button"
                class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                data-blog-filter={tag}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect />
      </div>

      {
        showFeatured && featured && (
          <div id="blog-featured" class="mt-10" data-blog-featured>
            <BlogCard post={featured} index={0} eager showDate layout="featured" />
          </div>
        )
      }

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {gridForPage.map((post, index) => (
          <BlogCard post={post} index={index} showDate />
        ))}
      </div>

      <p id="blog-empty" class="mt-10 hidden text-center text-muted-foreground" role="status">
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
        {nextPageHref ? (
          <a href={nextPageHref} class="text-sm font-medium text-primary hover:underline">
            Older posts →
          </a>
        ) : (
          <span />
        )}
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </Button>
      </div>
      <div class="mt-8">
        <SeoInternalCta />
      </div>
    </div>
  </section>

  <script>
    import { setupBlogIndexFilters } from '../../scripts/blog-index.ts';
    setupBlogIndexFilters();
  </script>
</BaseLayout>
