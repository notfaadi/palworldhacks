---
import SeoGuideLayout from '../../layouts/SeoGuideLayout.astro';
import { SEO_INTROS } from '../../data/seo-intros';
import SeoDataTable from '../../components/SeoDataTable.astro';
import { palworldTrainerSources, trainerFeatureList } from '../../data/palworld-trainers';
---

<SeoGuideLayout
  pathname="/palworld-trainers/"
  breadcrumbLabel="Trainers"
  intro={SEO_INTROS['/palworld-trainers/']!}
>
  <h2>Palworld trainer download options (Steam and Game Pass PC)</h2>
  <p>
    A Palworld trainer should stay external and RAM-based on patch 1.0.5 — that is our trust basis for calling tools
    lower-profile than DLL injectors on live co-op. We document sources below; grab the curated readme pack from{' '}
    <a href="/download/">download</a> and follow <a href="/how-to-install/">install steps</a> before enabling god mode.
  </p>
  <SeoDataTable
    caption="Trainer types — always verify 1.0.5 compatibility before launching Palworld"
    columns={[
      { key: 'name', label: 'Source type' },
      { key: 'type', label: 'Architecture' },
      { key: 'platform', label: 'Platform' },
      { key: 'notes', label: 'Notes' },
    ]}
    rows={palworldTrainerSources}
  />
  <h2>Palworld cheat engine table features</h2>
  <ul>
    {trainerFeatureList.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
  <h2>Undetected Palworld trainers — external, RAM-based</h2>
  <p>
    Easy Anti-Cheat still watches behavior on official realms. Use private servers or offline saves when testing infinite
    stamina, loot magnets or capture rate edits. Read the <a href="/faq/">safety FAQ</a> before joining public co-op with
    any Palworld trainer.
  </p>
</SeoGuideLayout>
