---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { organizationSchema, softwareApplicationHomeSchema, websiteSchema } from '../utils/schema';
import { webpSrc } from '../utils/responsiveImage';
import SeoHubLinks from '../components/SeoHubLinks.astro';
import SeoTrustStrip from '../components/SeoTrustStrip.astro';

const seo = resolvePageSeo('/');
const heroLcpImage = webpSrc('/images/gameplay/palworld-esp-wallhack.png', 512);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  ogImageAlt="Palworld Hacks & Cheats — Free Trainers, Mod Menu and Console Commands"
  jsonLd={[websiteSchema(), organizationSchema(), softwareApplicationHomeSchema()]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <SeoTrustStrip />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
  <SeoHubLinks />
</BaseLayout>
