---
import { Button } from '@/components/starwind/button';
---

<div class="not-prose mt-12 flex flex-col gap-3 rounded-xl border border-border bg-muted/20 p-6 sm:flex-row sm:items-center sm:justify-between">
  <p class="text-sm text-muted-foreground">
    Get the 1.0.5 pack and follow the install guide before using trainers on Steam or Game Pass PC.
  </p>
  <div class="flex flex-wrap gap-2">
    <Button as="a" href="/download/" variant="primary" size="sm">Download hacks</Button>
    <Button as="a" href="/how-to-install/" variant="outline" size="sm">How to install</Button>
  </div>
</div>
